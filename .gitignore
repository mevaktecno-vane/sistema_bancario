# ===============================
#  PROYECTO SISTEMA BANCARIO
# Archivo .gitignore actualizado
# ===============================

# --- Entornos virtuales ---
venv/
.venv/
env/
.env/

# --- Archivos compilados de Python ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Archivos temporales y logs ---
*.log
*.tmp
*.bak
*.swp

# --- Archivos generados automáticamente ---
*.pdf
*.xlsx
*.csv
*.db

# --- Configuración de IDEs (VS Code, PyCharm, etc.) ---
.vscode/
.idea/

# --- Dependencias y resultados de build ---
dist/
build/
*.egg-info/

# --- Archivos del sistema ---
.DS_Store
Thumbs.db

# ===============================
# EXCEPCIONES
# ===============================

# No ignorar la carpeta docs/ ni su contenido
!docs/
!docs/*.pdf
!docs/*.png
!docs/*.jpg
!docs/*.jpeg
!docs/*.md

# Mantener README y archivos principales visibles
!README.md
!requirements.txt